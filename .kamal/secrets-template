# ⚠️ COPY THIS TO .kamal/secrets AND FILL IN YOUR ACTUAL VALUES ⚠️
# DO NOT commit .kamal/secrets to git! It's already gitignored.

# GitHub Container Registry token (from Step 1)
KAMAL_REGISTRY_PASSWORD="ghp_your_github_pat_here"

# Rails secret key (from: bin/rails secret)
SECRET_KEY_BASE="your_secret_key_base_here"

# VAPID keys for push notifications (from: bin/rails runner command above)
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"

# SMTP credentials (get from your email provider)
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"

