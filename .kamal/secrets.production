RAILS_MASTER_KEY=$(cat config/credentials/production.key 2>/dev/null || cat config/master.key)
KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password -e production)
SECRET_KEY_BASE=$(rails credentials:fetch secret_key_base -e production)
SMTP_USERNAME=$(rails credentials:fetch smtp_username -e production)
SMTP_PASSWORD=$(rails credentials:fetch smtp_password -e production)
VAPID_PUBLIC_KEY=$(rails credentials:fetch vapid_public_key -e production)
VAPID_PRIVATE_KEY=$(rails credentials:fetch vapid_private_key -e production)