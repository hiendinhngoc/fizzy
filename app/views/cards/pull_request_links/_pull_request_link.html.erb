<li class="pr-link flex align-center gap-half">
  <span class="pr-link__icon">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
      <path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h1.5v2.128a2.251 2.251 0 1 0 1.5 0V8.5h1.5a2.25 2.25 0 0 0 2.25-2.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5a.75.75 0 0 1-.75-.75v-.878ZM11 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM8.75 12a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/>
    </svg>
  </span>
  <% if (github_pr_url = safe_github_pull_request_url(pull_request_link)) %>
    <%= link_to github_pr_url, github_pr_url, target: "_blank", rel: "noopener noreferrer", class: "pr-link__url" %>
  <% end %>
  <span class="pr-link__state pr-link__state--<%= pull_request_link.state %>"><%= pull_request_link.state %></span>
  <%= button_to card_pull_request_link_path(pull_request_link.card, pull_request_link), method: :delete, class: "btn btn--icon btn--subtle", data: { turbo_confirm: "Remove this PR link?" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  <% end %>
</li>
